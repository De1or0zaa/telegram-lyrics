# Telegram Bot Token (обязательно)
# Получите у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Настройки по умолчанию (можно переопределить через команды бота)
WORDS_PER_EDIT=3
DELAY=1.5

# Файл хранения настроек (на Railway ФС ephemeral, настройки сбросятся при перезапуске)
SETTINGS_FILE=bot_settings.json
